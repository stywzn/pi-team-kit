{
  "name": "pi-team-kit",
  "version": "0.9.0",
  "description": "Team workflow (lead + up to 4 workers + verifier + rework), lead-to-lead messages, playbooks from past projects, anti-hang command guard, auto-detected environment facts, plain-language output and a reusable toolbox for the pi coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "stywzn",
  "homepage": "https://github.com/stywzn/pi-team-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stywzn/pi-team-kit.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "multi-agent"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "ptk": "./bin/ptk.ts"
  },
  "files": [
    "agents",
    "bin",
    "docs",
    "examples",
    "extensions",
    "lib",
    "prompts",
    "skills",
    "toolbox",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "doctor": "node bin/ptk.ts doctor"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "dependencies": {
    "marked": "^18.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
